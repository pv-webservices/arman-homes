# Arman Homes static website. Replace the previous WordPress .htaccess.
DirectoryIndex index.html
Options -Indexes -MultiViews
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Keep certificate renewal requests accessible over HTTP.
  RewriteRule ^\.well-known/acme-challenge/ - [L]
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://armanhomes.in/$1 [R=301,L]
  # Only real content directories receive a trailing slash; missing routes remain 404.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ https://armanhomes.in/$1/ [R=301,L]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^armanhomes\.in$ [NC]
  RewriteRule ^ https://armanhomes.in%{REQUEST_URI} [R=301,L]
</IfModule>

# Revalidate HTML and indexing files after an update.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
