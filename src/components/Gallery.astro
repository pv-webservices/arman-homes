---
const { images, title } = Astro.props;
---
<div data-gallery><button class="gallery-main" data-gallery-main aria-label={`Enlarge photograph of ${title}`}><img src={images[0].src} alt={images[0].alt} width="1200" height="800" /></button><div class="gallery-thumbs" aria-label="Property photographs">{images.map((image: {src:string;alt:string}, index: number) => <button data-gallery-src={image.src} data-gallery-alt={image.alt} aria-label={`View photograph ${index + 1}`} aria-pressed={index === 0}><img src={image.src} alt={image.alt} width="120" height="80" loading="lazy" /></button>)}</div><dialog class="lightbox" aria-label="Enlarged property photograph"><button aria-label="Close enlarged photograph">✕</button><img src={images[0].src} alt={images[0].alt} width="1200" height="800" loading="lazy" /></dialog></div>
