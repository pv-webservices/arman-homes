---
// Life Republic film: a silent background loop, with the full film in a modal that loads only on demand.
import Icon from './Icon.astro';
interface Props { title?: string; text?: string }
const { title = 'A Township That Feels Like Home', text = '400+ acres of greenery, schools, parks and everyday conveniences — with a 30,000+ resident community already calling Life Republic home.' } = Astro.props;
---
<section class="film on-dark" aria-labelledby="film-title">
  <div class="film-video" aria-hidden="true">
    <!-- A lazy <img> instead of the video `poster` attribute: posters load eagerly and competed with the hero image. -->
    <img src="/images/projects/film-poster.webp" alt="" width="848" height="364" loading="lazy" decoding="async" />
    <video data-bg-video muted loop playsinline preload="none">
      <source src="/video/life-republic-loop.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="wrap film-copy" data-reveal>
    <p class="eyebrow">The Life Republic Film</p>
    <h2 id="film-title">{title}</h2>
    <p class="lead">{text}</p>
    <button class="play-link" type="button" data-film-open><span class="play-ring"><Icon name="play" size={26} /></span>Watch the Film</button>
  </div>
</section>
<dialog class="video-modal" data-film-modal aria-label="Life Republic film">
  <button class="modal-close" type="button" data-film-close aria-label="Close film"><Icon name="close" size={20} /></button>
  <video controls playsinline preload="none" data-poster="/images/projects/film-poster.webp">
    <source src="/video/life-republic-film.mp4" type="video/mp4" />
  </video>
</dialog>
