---
import Icon from './Icon.astro';
import { formatPrice } from '../data/properties.mjs';
const { property: p } = Astro.props;
const cover = p.images[0];
const small = cover.src.replace(/\.webp$/, '-small.webp');
---
<article class="property-card" data-property data-transaction={p.transaction} data-category={p.category} data-type={p.type} data-location={p.location} data-price={p.price} data-bedrooms={p.bedrooms}>
  <a class="property-image media zoom" href={`/properties/${p.slug}/`} tabindex="-1" aria-hidden="true">
    <img src={small} srcset={`${small} 768w, ${cover.src} 1536w`} sizes="(max-width: 640px) 80vw, (max-width: 1100px) 45vw, 22vw" alt="" width="768" height="512" loading="lazy" decoding="async" />
    <span class:list={['badge', { rent: p.transaction === 'rent' }]}>{p.transaction === 'rent' ? 'For Rent' : 'For Sale'}</span>
  </a>
  <div class="property-body">
    <h3><a href={`/properties/${p.slug}/`}>{p.title}</a></h3>
    <p class="property-location"><Icon name="pin" size={14} />{p.location}, Pune</p>
    <ul class="property-specs">
      {p.bedrooms && <li><Icon name="bed" size={15} />{p.bedrooms} Beds</li>}
      {p.bathrooms && <li><Icon name="bath" size={15} />{p.bathrooms} Baths</li>}
      {p.area && <li><Icon name="area" size={15} />{p.area.toLocaleString('en-IN')} Sq.Ft.</li>}
    </ul>
    <p class="property-price">{formatPrice(p)}</p>
    <a class="btn btn-sm btn-block" href={`/properties/${p.slug}/`} aria-label={`View details: ${p.title}, ${p.location}`}>View Details <Icon name="arrow" size={15} /></a>
  </div>
</article>
