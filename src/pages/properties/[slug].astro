---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { properties, formatPrice } from '../../data/properties.mjs';
export function getStaticPaths() { return properties.map(property => ({ params: { slug: property.slug }, props: { property } })); }
const { property: p } = Astro.props;
---
<Layout title={p.title} description={p.description.slice(0, 155)} solidHeader><section class="section detail-page"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/properties/">Properties</a><span>/</span><span>{p.title}</span></nav><p class="eyebrow">{p.transaction === 'rent' ? 'For Rent' : 'For Sale'} · {p.location}</p><h1>{p.title}</h1><div class="detail-specs">{p.bedrooms && <span>{p.bedrooms} {p.bedrooms === 1 ? 'Bedroom' : 'Bedrooms'}</span>}{p.bathrooms && <span>{p.bathrooms} Bathrooms</span>}{p.area && <span>{p.area} sq ft</span>}</div><div class="detail-grid"><div><Gallery images={p.images} title={p.title} /><div class="prose"><h2>About This Property</h2><p>{p.description}</p>{p.amenities?.length > 0 && <><h2>Amenities</h2><ul>{p.amenities.map((item: string) => <li>{item}</li>)}</ul></>}</div></div><aside class="inquiry-panel detail-aside"><p class="eyebrow">Your Next Step</p><h2>{formatPrice(p)}</h2><p>Contact Arman Homes to confirm availability and discuss the property.</p><a class="btn btn-navy" href="tel:+919354210824">Call +91 9354210824</a><a class="link-arrow" target="_blank" rel="noopener noreferrer" href={`https://wa.me/919354210824?text=${encodeURIComponent(`Hello Arman Homes, I would like to enquire about ${p.title} (${p.slug}).`)}`}>Enquire on WhatsApp →</a></aside></div></div></section><ContactCTA /></Layout>
