---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/site';
---
<Layout title="Page Not Found" description="This page could not be found. Return to Arman Homes to explore our property services in Pune." noindex>
  <section class="error-page on-dark">
    <div class="wrap">
      <p class="error-code" aria-hidden="true">404</p>
      <p class="eyebrow plain">A Different Direction</p>
      <h1>Page Not Found</h1>
      <p class="lead">The page may have moved, or the link may be incomplete. Let’s get you back to Arman Homes.</p>
      <div class="actions">
        <a class="btn" href="/">Back to Home <Icon name="arrow" size={17} /></a>
        <a class="btn btn-ghost-light" href="/properties/">Explore Properties</a>
        <a class="btn btn-ghost-light" href={business.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
        <a class="btn btn-ghost-light" href={`tel:${business.tel}`}>Call {business.phone}</a>
      </div>
    </div>
  </section>
</Layout>
